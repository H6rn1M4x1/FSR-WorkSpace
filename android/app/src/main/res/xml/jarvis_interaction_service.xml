<?xml version="1.0" encoding="utf-8"?>
<!-- Descriptor obligatorio para que Android acepte esta app como "App de asistente digital"
     predeterminada (Ajustes > Apps > Apps predeterminadas > App de asistente digital).
     recognitionService apunta a un stub (ver JarvisRecognitionService): Jarvis no transcribe por
     ahí, lo hace JarvisVoiceInteractionSession directamente con SpeechRecognizer, pero Android
     exige declarar uno igual para habilitar el resto del flujo. -->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="com.fsrworkspace.app.JarvisVoiceInteractionSessionService"
    android:recognitionService="com.fsrworkspace.app.JarvisRecognitionService"
    android:settingsActivity="com.fsrworkspace.app.MainActivity"
    android:supportsAssist="true" />
