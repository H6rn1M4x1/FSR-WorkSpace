{
  "name": "react-example",
  "private": true,
  "version": "1.5.12",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "cap:sync": "vite build && cap sync android && rm -rf android/app/src/main/assets/public/downloads",
    "cap:open:android": "cap open android",
    "electron:bundle-main": "esbuild electron/main.cjs --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs && esbuild electron/preload.cjs --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "electron:start": "vite build && npm run electron:bundle-main && electron .",
    "electron:build:win": "vite build && npm run electron:bundle-main && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/genai": "^2.4.0",
    "@netlify/functions": "^2.8.2",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.45.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.12.0",
    "chart.js": "^4.5.1",
    "country-state-city": "^3.2.1",
    "dotenv": "^17.2.3",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.5.0",
    "glob": "^13.0.6",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "mermaid": "^12.0.0",
    "motion": "^12.23.24",
    "otplib": "^13.4.1",
    "pdfjs-dist": "^5.4.624",
    "postprocessing": "^6.39.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-body-highlighter": "^2.0.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.1",
    "react-muscle-highlighter": "^1.2.0",
    "recharts": "^3.10.0",
    "simple-icons": "^16.36.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.185.1",
    "vite": "^6.2.3",
    "wavesurfer.js": "^7.12.11",
    "web-push": "^3.6.7",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.32.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "build": {
    "appId": "com.fsrworkspace.app",
    "productName": "FSR Workspace",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "!dist/server.cjs",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://fsrworkspace.netlify.app/downloads/win/"
    }
  }
}
